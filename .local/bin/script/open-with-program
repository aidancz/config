#!/usr/bin/env schemesh-script
#!scheme

(define input (command-line-arguments))

(define pick
  (lambda (items prompt)
    (sh-run/string-rtrim-newlines
      {(shell-expr (display items)) | dmenu -l 64 -i -p (values prompt)}
    )))

(define item
  (pick
"\
PAGER
EDITOR
BROWSER
"
"type directly or select"
  ))

(case item
  ("PAGER"
    (sh-run/i {$TERMINAL -e $PAGER (values input)}))
  ("EDITOR"
    (sh-run/i {$TERMINAL -e $EDITOR (values input)}))
  ("BROWSER"
    (sh-run/i {$TERMINAL -e $BROWSER (values input)}))
  (else
    (sh-run/i {$TERMINAL -e (values item) (values input)}))
)
