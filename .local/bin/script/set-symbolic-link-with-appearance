#!/usr/bin/env schemesh-script
#!scheme

;; NOTE: require set-symbolic-link
;; NOTE: require system-actions

;; "dark" or "light"
(define input
  (cond
    ((null? (command-line-arguments)) #f)
    (else (car (command-line-arguments)))))

(define pick
  (lambda (items prompt)
    (sh-run/string-rtrim-newlines
      {(shell-expr (display items)) | dmenu -l 64 -i -p (values prompt)}
    )))

(define item (or input
  (pick
"\
dark
light
"
"appearance"
  )))

(define repo "/home/aidan/sync_git/config")
(define A_config (string-append repo "/.config"))
(define B_config (sh-env-ref #t "XDG_CONFIG_HOME"))

(define rm
  (lambda (path)
    (sh-run {rm -rf (values path)})))

(define cp
  (lambda (path clone)
    (sh-run {cp -r (values path) (values clone)})))

(define sync
  (lambda (from to to-procedure)
    (rm to)
    (cp from to)
    (to-procedure to)
  ))

(define set-appearance-dark
  (lambda ()
    (void)
    ;; do nothing
  ))

(define set-appearance-light
  (lambda ()

    ;; x11
    (sync
      (string-append A_config "/x11")
      (string-append B_config "/x11")
      (lambda (to)
        (sh-run {sed -i -e '/nofrils_light/,/nofrils_light/s/! \(.\+\)/\1/' (string-append to "/.Xresources")})))

    ;; gtk-3.0
    (sync
      (string-append A_config "/gtk-3.0")
      (string-append B_config "/gtk-3.0")
      (lambda (to)
        (sh-run {echo "gtk-theme-name=Adwaita" >> (string-append to "/settings.ini")})))

    ;; gtk-4.0
    (sync
      (string-append A_config "/gtk-4.0")
      (string-append B_config "/gtk-4.0")
      (lambda (to)
        (sh-run {echo "gtk-theme-name=Adwaita" >> (string-append to "/settings.ini")})))

    ;; qt5ct
    (sync
      (string-append A_config "/qt5ct")
      (string-append B_config "/qt5ct")
      (lambda (to)
        (sh-run {sed -i '/darker/s/darker/simple/' (string-append to "/qt5ct.conf")})))

    ;; qt6ct
    (sync
      (string-append A_config "/qt6ct")
      (string-append B_config "/qt6ct")
      (lambda (to)
        (sh-run {sed -i '/darker/s/darker/simple/' (string-append to "/qt6ct.conf")})))

    ;; zathura
    (sync
      (string-append A_config "/zathura")
      (string-append B_config "/zathura")
      (lambda (to)
        (sh-run {echo "set recolor false" >> (string-append to "/zathurarc")})))

    ;; dunst
    (sync
      (string-append A_config "/dunst")
      (string-append B_config "/dunst")
      (lambda (to)
        (sh-run {sed -i -e '/dunst_light/,/dunst_light/s/# \(.\+\)/\1/' (string-append to "/dunstrc")})))

    ;; fcitx5
    (sync
      (string-append A_config "/fcitx5")
      (string-append B_config "/fcitx5")
      (lambda (to)
        (sh-run {echo "Theme=default" >> (string-append to "/conf/classicui.conf")})))

  ))

(define reload-programs
  (lambda ()
    (sh-run
      {
        xrdb (shell-string {$HOME/.Xresources}) 2>/dev/null
        system-actions "window-manager renew"
      })
    (sh-run {killall -q dunst; dunst &})
    (sh-run {killall -q fcitx5; fcitx5 &})
  ))

(case item
  ("dark"
   (sh-run {set-symbolic-link})
   (set-appearance-dark)
   (reload-programs))
  ("light"
   (sh-run {set-symbolic-link})
   (set-appearance-light)
   (reload-programs))
)
