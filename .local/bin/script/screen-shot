#!/usr/bin/env schemesh
#!scheme

(define pick
  (lambda (items prompt)
    (sh-run/string-rtrim-newlines
      {(shell-expr (display items)) | dmenu -l 64 -i -p (values prompt)}
    )))

(define output
  (string-append
    (shell-string {$HOME})
    "/"
    (sh-run/string-rtrim-newlines {date +'%Y%m%d-%H%M%S-%N'})
    ".png"))

(define xclip {xclip -sel clip -t image/png})

(define get-active-window
  (lambda ()
    (sh-run/string-rtrim-newlines {xdotool getactivewindow})))

(define item
  (pick
"\
selected
window
screen
"
"screen capture area"
  ))

(case item
  ("selected"
    (sh-run
      {
        maim --select \
        | tee (values output) | (values xclip)
      }))
  ("window"
    (sh-run
      {
        maim --quiet --delay 0.2 --window (get-active-window) \
        | tee (values output) | (values xclip)
      }))
  ("screen"
    (sh-run
      {
        maim --quiet --delay 0.2 \
        | tee (values output) | (values xclip)
      }))
)
