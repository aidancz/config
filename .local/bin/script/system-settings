#!/usr/bin/env schemesh
#!scheme

(define pick
  (lambda (items prompt)
    (sh-run/string-rtrim-newlines
      {(shell-expr (display items)) | dmenu -l 64 -i -p (values prompt)}
    )))

(define item
  (pick
"\
set-symbolic-link-with-appearance dark
set-symbolic-link-with-appearance light
set-keyboard
network
volume
"
"system setting"
  ))

(case item
  ("set-symbolic-link-with-appearance dark"
    (sh-run {set-symbolic-link-with-appearance dark}))
  ("set-symbolic-link-with-appearance light"
    (sh-run {set-symbolic-link-with-appearance light}))
  ("set-keyboard"
    (sh-run {set-keyboard}))
  ("network"
    (sh-run {setsid -f "$TERMINAL" -e nmtui}))
  ("volume"
    (sh-run {setsid -f "$TERMINAL" -e pulsemixer}))
)
